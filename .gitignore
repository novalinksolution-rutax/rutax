# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# respaldos locales de base de datos / Storage (docs/ops/restauracion.md) —
# nunca versionar dumps: pueden contener datos personales/financieros.
/backups/
.tmp-drill/

# typescript
*.tsbuildinfo
next-env.d.ts

# Cartografía generada de la Torre de control: el basemap PMTiles de la RM
# (~19 MB) y el CLI que lo recorta. Se regenera con
# `node scripts/mapa/construir-basemap.mjs` y se publica al bucket
# `contexto-mapas`. La geometría comunal DPA 2023, en cambio, SÍ se versiona
# (public/mapas/comunas-rm.topojson.json — 113 KB).
/.artefactos
